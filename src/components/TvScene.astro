---
import type { TvChannel } from '../data/channels';

interface Props {
  /** The TV with 2K textures, for wide screens. */
  modelUrl?: string;
  /** The same TV with lighter textures, for screens up to 768 px wide. */
  mobileModelUrl?: string;
  /** Videos for the screen; a click on the TV goes to the next one. Without them: snow and "NO SIGNAL". */
  channels?: TvChannel[];
  /** Click of the channel knob on every switch. */
  knobSound?: string;
  /** Caption for a channel without a video. */
  emptyLabel?: string;
  /** A click on the TV opens the channel's link (with a hint by the cursor) instead of switching. */
  clickOpensLink?: boolean;
}

const {
  modelUrl = '/models/crt-tv-2k.glb',
  mobileModelUrl = '/models/crt-tv-1k.glb',
  channels = [],
  knobSound = '/audio/tv_knob.mp3',
  emptyLabel = 'NO SIGNAL',
  clickOpensLink = false,
} = Astro.props;
const first = channels[0];
const total = String(channels.length).padStart(2, '0');
---

<div
  class:list={['tv-scene', { switchable: channels.length > 0 }]}
  data-tv-scene
  data-model={modelUrl}
  data-mobile-model={mobileModelUrl}
  data-channels={JSON.stringify(channels)}
  data-knob-sound={knobSound}
  data-click-link={clickOpensLink ? '' : undefined}
>
  <canvas
    aria-label={!first ? 'Old CRT TV showing static'
      : clickOpensLink ? 'Old CRT TV playing videos of projects; click to watch the trailer on YouTube'
      : 'Old CRT TV playing videos of projects; click to switch the channel'}
    role="img"
  ></canvas>
  {clickOpensLink && <span class="hint mono" aria-hidden="true">Watch on YouTube ↗</span>}
  <div class="caption mono" aria-live="polite">
    {first ? (
      <>
        <div class="title"><b data-channel-title>{first.title}</b><b class="lost">NO SIGNAL</b><b class="empty">{emptyLabel}</b></div>
        <div class="meta">
          CH <span data-channel-number>01</span>/{total}
          {channels.length > 1 && <>{' · '}<button type="button" data-next>next ▸</button></>}
          <span data-channel-link-wrap hidden={!first.link}>
            {' · '}<a data-channel-link href={first.link} target="_blank" rel="noopener">YouTube ↗</a>
          </span>
        </div>
      </>
    ) : (
      <>
        <div class="title"><b>NO SIGNAL</b></div>
        <div class="meta">CH 01</div>
      </>
    )}
  </div>
</div>

<style>
  .tv-scene { position: relative; width: 100%; height: 100%; }

  /* warm glow behind the TV */
  .tv-scene::before {
    content: "";
    position: absolute;
    left: 8%; right: 0; top: 6%; bottom: 0;
    /* colour and strength follow the picture (screen-glow.ts); amber until there is one */
    background: radial-gradient(
      closest-side at 50% 55%,
      rgb(var(--tv-glow, 232 169 75) / calc(0.26 * var(--tv-glow-strength, 1))),
      rgb(var(--tv-glow, 232 169 75) / calc(0.09 * var(--tv-glow-strength, 1))) 55%,
      transparent 100%
    );
    filter: blur(8px);
    pointer-events: none;
  }

  canvas {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .is-ready canvas { opacity: 1; }
  /* only the TV itself is clickable (crt-tv.ts sets "over-tv" while the cursor is on it) */
  .switchable.over-tv canvas { cursor: pointer; }
  /* when a click opens the link, a channel without one isn't clickable */
  .tv-scene[data-click-link]:not(.has-link) canvas { cursor: default; }

  /* "Watch on YouTube" by the cursor (positioned by the script) */
  .hint {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    padding: 6px 10px;
    border: 1px solid var(--accent);
    border-radius: 6px;
    background: var(--bg);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--accent);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s;
  }
  .tv-scene.has-link.over-tv .hint { opacity: 1; }

  /* the channel's name large, like an on-screen label of an old TV; the rest small under it */
  .caption {
    position: absolute;
    right: var(--tv-caption-right, 24px);
    bottom: var(--tv-caption-bottom, 24px);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-align: right;
    text-transform: uppercase;
    color: var(--muted);
  }
  .caption .title { font-size: clamp(16px, 4.6vw, 22px); letter-spacing: 0.03em; }
  .caption b { font-weight: 500; color: var(--accent); }

  /* the channel's video failed to load (crt-tv.ts sets data-signal="lost") */
  .caption .lost,
  .caption .empty,
  .tv-scene:is([data-signal="lost"], [data-signal="none"]) [data-channel-title] { display: none; }
  .tv-scene[data-signal="lost"] .caption .lost { display: inline; }
  /* a channel with no video at all (crt-tv.ts sets data-signal="none") */
  .tv-scene[data-signal="none"] .caption .empty { display: inline; }
  .caption a,
  .caption button {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--fg);
    text-decoration: none;
    cursor: pointer;
  }
  .caption a:hover,
  .caption button:hover { color: var(--accent); }
</style>

<script>
  import type { TvChannel } from '../data/channels';

  // Three.js lands in its own chunk and loads only on pages that use this component.
  for (const el of document.querySelectorAll<HTMLElement>('[data-tv-scene]')) {
    const channels: TvChannel[] = JSON.parse(el.dataset.channels ?? '[]');
    const number = el.querySelector('[data-channel-number]');
    const title = el.querySelector('[data-channel-title]');
    const linkWrap = el.querySelector<HTMLElement>('[data-channel-link-wrap]');
    const link = el.querySelector<HTMLAnchorElement>('[data-channel-link]');
    const canvas = el.querySelector('canvas')!;
    const hint = el.querySelector<HTMLElement>('.hint');
    const clickOpensLink = 'clickLink' in el.dataset;
    let current = channels[0];

    // the hint follows the cursor; it shows while the cursor is on the TV itself (CSS)
    if (hint) {
      canvas.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse') return;
        const r = el.getBoundingClientRect();
        hint.style.transform = `translate(${e.clientX - r.left + 16}px, ${e.clientY - r.top + 18}px)`;
      });
    }

    // phones get the model with lighter textures
    const small = window.matchMedia('(max-width: 768px)').matches;

    import('../scenes/crt-tv').then(({ mount }) => {
      const tv = mount(el, {
        modelUrl: (small && el.dataset.mobileModel) || el.dataset.model!,
        videos: channels.map((c) => c.video ?? ''),
        clickSound: el.dataset.knobSound,
        onScreenClick: clickOpensLink
          ? () => { if (current?.link) window.open(current.link, '_blank', 'noopener'); }
          : undefined,
        onChannel(index) {
          const channel = channels[index];
          current = channel;
          el.classList.toggle('has-link', !!channel.link);
          if (number) number.textContent = String(index + 1).padStart(2, '0');
          if (title) title.textContent = channel.title;
          if (linkWrap && link) {
            linkWrap.hidden = !channel.link;
            if (channel.link) link.href = channel.link;
          }
          // the page can follow what's on: el.addEventListener('tv:channel', (e) => e.detail)
          el.dispatchEvent(new CustomEvent('tv:channel', { detail: index }));
        },
      });
      el.querySelector('[data-next]')?.addEventListener('click', () => tv.next());
      // the page can tune the TV: el.dispatchEvent(new CustomEvent('tv:select', { detail: index }))
      el.addEventListener('tv:select', (e) => tv.select((e as CustomEvent<number>).detail));
    });
  }
</script>
