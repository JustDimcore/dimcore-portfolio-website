---
import type { TvChannel } from '../data/channels';

interface Props {
  /** The TV with 2K textures, for wide screens. */
  modelUrl?: string;
  /** The same TV with lighter textures, for screens up to 768 px wide. */
  mobileModelUrl?: string;
  /** Videos for the screen; a click on the TV goes to the next one. Without them: snow and "NO SIGNAL". */
  channels?: TvChannel[];
  /** Click of the channel knob on every switch. */
  knobSound?: string;
}

const {
  modelUrl = '/models/crt-tv-2k.glb',
  mobileModelUrl = '/models/crt-tv-1k.glb',
  channels = [],
  knobSound = '/audio/tv_knob.mp3',
} = Astro.props;
const first = channels[0];
const total = String(channels.length).padStart(2, '0');
---

<div
  class:list={['tv-scene', { switchable: channels.length > 0 }]}
  data-tv-scene
  data-model={modelUrl}
  data-mobile-model={mobileModelUrl}
  data-channels={JSON.stringify(channels)}
  data-knob-sound={knobSound}
>
  <canvas
    aria-label={first ? 'Old CRT TV playing videos of projects; click to switch the channel' : 'Old CRT TV showing static'}
    role="img"
  ></canvas>
  <div class="caption mono" aria-live="polite">
    {first ? (
      <>
        CH <span data-channel-number>01</span>/{total}{' · '}<b data-channel-title>{first.title}</b><b class="lost">NO SIGNAL</b>
        {channels.length > 1 && <>{' · '}<button type="button" data-next>next ▸</button></>}
        <span data-channel-link-wrap hidden={!first.link}>
          {' · '}<a data-channel-link href={first.link} target="_blank" rel="noopener">YouTube ↗</a>
        </span>
      </>
    ) : (
      <>CH 01 · <b>NO SIGNAL</b></>
    )}
  </div>
</div>

<style>
  .tv-scene { position: relative; width: 100%; height: 100%; }

  /* warm glow behind the TV */
  .tv-scene::before {
    content: "";
    position: absolute;
    left: 8%; right: 0; top: 6%; bottom: 0;
    background: radial-gradient(closest-side at 50% 55%, rgba(232, 169, 75, 0.16), rgba(232, 169, 75, 0.05) 55%, transparent 100%);
    filter: blur(8px);
    pointer-events: none;
  }

  canvas {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .is-ready canvas { opacity: 1; }
  .switchable canvas { cursor: pointer; }

  .caption {
    position: absolute;
    right: var(--tv-caption-right, 24px);
    bottom: var(--tv-caption-bottom, 24px);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-align: right;
    text-transform: uppercase;
    color: var(--muted);
  }
  .caption b { font-weight: 500; color: var(--accent); }

  /* the channel's video failed to load (crt-tv.ts sets data-signal="lost") */
  .caption .lost,
  .tv-scene[data-signal="lost"] [data-channel-title] { display: none; }
  .tv-scene[data-signal="lost"] .caption .lost { display: inline; }
  .caption a,
  .caption button {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--fg);
    text-decoration: none;
    cursor: pointer;
  }
  .caption a:hover,
  .caption button:hover { color: var(--accent); }
</style>

<script>
  import type { TvChannel } from '../data/channels';

  // Three.js lands in its own chunk and loads only on pages that use this component.
  for (const el of document.querySelectorAll<HTMLElement>('[data-tv-scene]')) {
    const channels: TvChannel[] = JSON.parse(el.dataset.channels ?? '[]');
    const number = el.querySelector('[data-channel-number]');
    const title = el.querySelector('[data-channel-title]');
    const linkWrap = el.querySelector<HTMLElement>('[data-channel-link-wrap]');
    const link = el.querySelector<HTMLAnchorElement>('[data-channel-link]');

    // phones get the model with lighter textures
    const small = window.matchMedia('(max-width: 768px)').matches;

    import('../scenes/crt-tv').then(({ mount }) => {
      const tv = mount(el, {
        modelUrl: (small && el.dataset.mobileModel) || el.dataset.model!,
        videos: channels.map((c) => c.video),
        clickSound: el.dataset.knobSound,
        onChannel(index) {
          const channel = channels[index];
          if (number) number.textContent = String(index + 1).padStart(2, '0');
          if (title) title.textContent = channel.title;
          if (linkWrap && link) {
            linkWrap.hidden = !channel.link;
            if (channel.link) link.href = channel.link;
          }
        },
      });
      el.querySelector('[data-next]')?.addEventListener('click', () => tv.next());
    });
  }
</script>
