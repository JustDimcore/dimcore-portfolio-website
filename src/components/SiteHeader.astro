---
// The bar at the top: the name, the menu and the theme switch, the same on every page.
// On the home page it slides in once the menu under the name is scrolled away (index.astro
// toggles "is-shown"); on other pages it's simply there.
import ThemeToggle from './ThemeToggle.astro';
import { links } from '../data/profile';

interface Props {
  /** The home page: links point at its sections, and the bar starts hidden. */
  home?: boolean;
  /** The page this is, marked in the menu. */
  current?: 'projects';
}

const { home = false, current } = Astro.props;
---

<header class:list={['bar', { floating: home }]} data-bar={home ? '' : undefined} inert={home}>
  <div class="wrap bar-inner">
    <a class="bar-name mono" href={home ? '#top' : '/'} aria-label={home ? 'Dmytro Ilchenko, back to top' : 'Dmytro Ilchenko, home page'}>
      <span aria-hidden="true"><span class="prompt">~$ </span>dmytro<span class="sep">_</span>ilchenko<span class="cursor"></span></span>
    </a>
    <nav class="bar-nav" aria-label="Main">
      <!-- from another page "About me" is just the home page, from its top -->
      <a href={home ? '#about' : '/'}><i>01</i>About me</a>
      <a href={links.projects} aria-current={current === 'projects' ? 'page' : undefined}><i>02</i>Projects</a>
      <a href={home ? '#contact' : '/#contact'}><i>03</i>Contact</a>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .bar {
    position: relative;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  /* home: fixed to the top, hidden until the page asks */
  .floating {
    position: fixed;
    inset: 0 0 auto;
    transform: translateY(-100%);
    visibility: hidden;
    transition: transform 0.3s ease, visibility 0s linear 0.3s;
  }
  .floating.is-shown { transform: none; visibility: visible; transition: transform 0.3s ease; }
  @media (prefers-reduced-motion: reduce) { .floating, .floating.is-shown { transition: none; } }

  .bar-inner { display: flex; align-items: center; gap: 24px; height: 60px; }
  .bar-name { font-size: 18px; font-weight: 700; letter-spacing: -0.02em; text-decoration: none; white-space: nowrap; }
  .prompt, .sep { font-weight: 400; color: var(--muted); }
  .cursor { display: inline-block; width: 0.55em; height: 0.95em; margin-left: 0.08em; vertical-align: -0.12em; background: var(--accent); }
  @media (prefers-reduced-motion: no-preference) { .cursor { animation: blink 1.1s steps(1) infinite; } }
  @keyframes blink { 50% { opacity: 0; } }

  .bar-nav { display: flex; gap: 28px; margin-left: auto; font-size: 15px; white-space: nowrap; }
  .bar-nav a { display: flex; align-items: baseline; gap: 8px; text-decoration: none; transition: color 0.2s; }
  .bar-nav i { font-style: normal; font-size: 0.8em; color: var(--faint); transition: color 0.2s; }
  .bar-nav a:hover, .bar-nav a[aria-current], .bar-name:hover { color: var(--accent); }
  .bar-nav a:hover i { color: var(--muted); }

  @media (max-width: 860px) {
    .bar-nav i { display: none; }
    .bar-nav { gap: 18px; }
  }
  @media (max-width: 640px) {
    .bar-inner { height: 52px; gap: 12px; }
    .bar-name { font-size: 14px; }
    .bar-name .prompt, .bar-name .cursor { display: none; }
    .bar-nav { gap: 12px; font-size: 12px; }
  }
  /* phones: the bar is just the links, spread across */
  @media (max-width: 480px) {
    .bar-name { display: none; }
    .bar-nav { flex: 1; justify-content: space-between; font-size: 13px; }
  }
</style>
