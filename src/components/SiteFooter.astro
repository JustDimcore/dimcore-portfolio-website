---
import { links } from '../data/profile';
---

<footer class="wrap">
  <div class="footer">
    <p>© {new Date().getFullYear()} Dmytro Ilchenko</p>
    <p><a href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a> · <a href={links.github} target="_blank" rel="noopener">GitHub</a></p>
  </div>
</footer>

<style>
  .footer { display: flex; justify-content: space-between; gap: 16px; padding: 24px 0 40px; border-top: 1px solid var(--line); font-size: 13px; color: var(--muted); }
  p { margin: 0; }
  a { text-decoration: none; }
  a:hover { color: var(--fg); }
</style>
