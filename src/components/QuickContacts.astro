---
// Email, LinkedIn and GitHub at hand, plus the theme switch. The email copies on click.
// Brand marks: Simple Icons (CC0).
import ThemeToggle from './ThemeToggle.astro';
import { links } from '../data/profile';
---

<div class="quick">
  <button type="button" class="mail" data-copy-mail={links.email} aria-label={`Copy ${links.email}`}>
    <span class="text">{links.email}</span>
    <span class="done-text" aria-hidden="true">Copied to clipboard</span>
    <span class="icon" aria-hidden="true">
      <svg class="line copy" viewBox="0 0 24 24"><rect x="8.5" y="8.5" width="11" height="11" rx="2" /><path d="M15.5 8.5V6.5a2 2 0 0 0-2-2h-7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h2" /></svg>
      <svg class="line check" viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
    </span>
  </button>
  <a class="round" href={links.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
  </a>
  <a class="round" href={links.github} target="_blank" rel="noopener" aria-label="GitHub">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></svg>
  </a>
  <span class="sep" aria-hidden="true"></span>
  <ThemeToggle />
</div>

<script>
  // Copy the address; the button says so for a moment.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-mail]')) {
    let timer = 0;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copyMail!);
      } catch {
        window.location.href = `mailto:${button.dataset.copyMail}`;   // no clipboard: write instead
        return;
      }
      button.classList.add('is-done');
      clearTimeout(timer);
      timer = window.setTimeout(() => button.classList.remove('is-done'), 1600);
    });
  }
</script>

<style>
  .quick { display: flex; align-items: center; gap: 10px; }
  svg { display: block; width: 17px; height: 17px; fill: currentColor; }
  svg.line { fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }

  /* the address with a copy button inside */
  .mail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 34px;
    padding: 0 4px 0 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: none;
    font: inherit;
    font-size: 14px;
    color: var(--fg);
    cursor: pointer;
    transition: border-color 0.2s;
  }
  .mail:hover { border-color: var(--accent); }
  .icon { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: color-mix(in srgb, var(--fg) 8%, transparent); color: var(--muted); transition: color 0.2s, background 0.2s; }
  .icon svg { width: 15px; height: 15px; }
  .mail:hover .icon { color: var(--accent); }
  .done-text, .check { display: none; }
  .is-done { border-color: var(--accent); }
  .is-done .text, .is-done .copy { display: none; }
  .is-done .done-text, .is-done .check { display: block; }
  .is-done .icon { color: var(--accent); background: color-mix(in srgb, var(--accent) 15%, transparent); }

  .round {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--muted);
    transition: color 0.2s, border-color 0.2s;
  }
  .round:hover { color: var(--accent); border-color: var(--accent); }
  .sep { width: 1px; height: 20px; margin: 0 4px; background: var(--line); }

  /* phones: tighter, so it fits in one row */
  @media (max-width: 480px) {
    .quick { gap: 6px; }
    .mail { font-size: 13px; gap: 8px; padding-left: 12px; }
    .sep { display: none; }
  }
</style>
