---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
// The Latin files of both fonts start loading with the page, not after the CSS is parsed:
// otherwise every page's first frame is set in the fallback font and then jumps.
import sansFont from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import monoFont from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Dmytro Ilchenko — software engineer in game development (Unity, C#) and the web (TypeScript, Angular).',
} = Astro.props;

// Link previews (LinkedIn, Telegram, Slack…) need an absolute image URL: set `site` in
// astro.config.mjs once the domain is known; until then the path is relative.
const ogImage = Astro.site ? new URL('/og.png', Astro.site).href : '/og.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>

    <!-- link preview (public/og.png, 1200×630) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- the saved colour theme goes on before the first paint; without one the system setting decides (global.css) -->
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
