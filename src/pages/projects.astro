---
import Base from '../layouts/Base.astro';
import TvScene from '../components/TvScene.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Lightbox from '../components/Lightbox.astro';
import { projects } from '../data/projects';
import { projectChannels } from '../data/channels';

const youtubeId = (url: string) => url.match(/(?:youtu\.be\/|[?&]v=)([\w-]{11})/)?.[1];
---

<Base
  title="Projects — Dmytro Ilchenko"
  description="Games Dmytro Ilchenko worked on: Invokers: Titan Legacy, Raid: Shadow Legends, Stormfall, Soldiers Inc, Nords and two projects under NDA."
>
  <SiteHeader current="projects" />

  <main class="wrap page">
    <div class="list">
      <h1>Projects</h1>
      <p class="intro">Games I've worked on, newest first.<span class="tunes"> Scroll and the TV tunes in to each one, except the two under NDA.</span></p>

      {projects.map((p, i) => (
        <article class:list={['project', { nda: p.nda, 'is-on': i === 0 }]} data-project={i} aria-labelledby={`project-${i}`}>
          <p class="meta">{p.studio} · {p.years}</p>
          {p.nda ? (
            <>
              <!-- no name to show: the line describes the game, and says why -->
              <h2 id={`project-${i}`}>{p.title}</h2>
              <p class="nda-note">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2" /><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5" /></svg>
                <b>Under NDA</b><span>the name and footage can't be shown</span>
              </p>
            </>
          ) : (
            <h2 id={`project-${i}`}>{p.title}</h2>
          )}
          <p class="sub">{p.genre} · {p.platforms} · {p.role}</p>
          <p class="summary">{p.summary}</p>
          <ul class="points">{p.points.map((x) => <li>{x}</li>)}</ul>
          <p class="stack">{p.stack.join(', ')}</p>
          {/* the trailer and screenshots; on desktop the TV shows the one under the cursor */}
          {p.gallery && (
            <div
              class="gallery"
              data-gallery={JSON.stringify([
                ...(p.link ? [{ kind: 'video', youtube: youtubeId(p.link), cover: p.gallery.cover ?? p.gallery.shots[0]?.thumb }] : []),
                ...p.gallery.shots.map((s, n) => ({ kind: 'image', ...s, alt: `${p.title}, screenshot ${n + 1}` })),
              ])}
              data-title={p.title}
            >
              {p.link && (
                <button type="button" class="tile trailer" data-item="0" aria-label={`Play the ${p.title} trailer`}>
                  <img src={p.gallery.cover ?? p.gallery.shots[0]?.thumb} alt="" decoding="async" />
                  <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" /></svg></span>
                </button>
              )}
              {p.gallery.shots.map((s, n) => (
                <button type="button" class="tile" data-item={n + (p.link ? 1 : 0)} aria-label={`Screenshot ${n + 1}`}>
                  <img src={s.thumb} alt="" decoding="async" />
                </button>
              ))}
            </div>
          )}
          {p.gallery && <p class="gallery-note">Point at a screenshot to see it on the TV, click to open it full size.</p>}
          {(p.site || p.link) && (
            <p class="links">
              {p.site && <a href={p.site.url} target="_blank" rel="noopener">{p.site.label} ↗</a>}
              {p.link && <a href={p.link} target="_blank" rel="noopener">Trailer on YouTube ↗</a>}
            </p>
          )}
        </article>
      ))}
    </div>

    <!-- stays in view and plays the project being read -->
    <aside class="screen">
      <div class="sticky"><TvScene channels={projectChannels} emptyLabel="UNDER NDA" pageDriven="(min-width: 1025px)" /></div>
    </aside>
  </main>

  <SiteFooter />
  <Lightbox />
</Base>

<script>
  // The project being read is the last one whose top has passed a line a bit above the middle
  // of what's visible below the bar. The highlight moves right away;
  // the TV tunes in once the scrolling settles, so a quick scroll doesn't flick through every
  // channel on the way. "next" on the TV moves the highlight too.
  const tv = document.querySelector<HTMLElement>('[data-tv-scene]');
  const bar = document.querySelector<HTMLElement>('header.bar');
  const items = [...document.querySelectorAll<HTMLElement>('[data-project]')];
  const SETTLE = 120;   // ms of no change before the TV switches

  function reading() {
    const top = bar?.getBoundingClientRect().bottom ?? 0;
    const line = top + (innerHeight - top) * 0.4;
    // at the very bottom the last project may never reach the line: it's the one being read then
    if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) return items.length - 1;
    let index = 0;
    items.forEach((el, i) => { if (el.getBoundingClientRect().top <= line) index = i; });
    return index;
  }

  // Room after the list so the last project can reach the line too; the footer counts towards it.
  const list = document.querySelector<HTMLElement>('.list');
  const footer = document.querySelector<HTMLElement>('footer');
  function makeRoom() {
    if (!list || !items.length) return;
    const top = bar?.offsetHeight ?? 0;
    const below = (innerHeight - top) * 0.6;
    const last = items[items.length - 1].offsetHeight + (footer?.offsetHeight ?? 0);
    list.style.paddingBottom = `${Math.max(48, Math.ceil(below - last))}px`;
  }
  makeRoom();
  window.addEventListener('resize', makeRoom);

  let wanted = 0;
  let timer = 0;
  let frame = 0;
  function onScroll() {
    if (frame) return;
    frame = requestAnimationFrame(() => {
      frame = 0;
      const index = reading();
      if (index === wanted) return;
      wanted = index;
      highlight(index);
      clearTimeout(timer);
      if (wide.matches) timer = window.setTimeout(tune, SETTLE);
    });
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  function highlight(on: number) {
    items.forEach((el, i) => el.classList.toggle('is-on', i === on));
  }
  // On narrow screens the TV scrolls away above the list: scrolling doesn't tune it, and its
  // own channel switches (clicks, "next") don't move the highlight.
  const wide = matchMedia('(min-width: 1025px)');
  const tune = () => tv?.dispatchEvent(new CustomEvent('tv:select', { detail: wanted }));
  wide.addEventListener('change', () => { if (wide.matches) tune(); });
  tv?.addEventListener('tv:channel', (e) => { if (wide.matches) highlight((e as CustomEvent<number>).detail); });

  // opened halfway down (reload, back): start from the project in view
  wanted = reading();
  highlight(wanted);
  if (wanted && wide.matches) tune();

  // Galleries. Desktop: the TV shows the screenshot under the cursor, and a click opens it full
  // size, flying out of the TV's screen. Phones (no hover): a tap opens it from the thumbnail.
  const hoverTv = matchMedia('(min-width: 1025px) and (hover: hover)');
  function screenRect() {
    const box: { rect: DOMRect | null } = { rect: null };
    tv?.dispatchEvent(new CustomEvent('tv:rect', { detail: box }));
    const r = box.rect;
    return r && r.bottom > 0 && r.top < innerHeight ? r : null;   // only while the screen is in view
  }
  const showOnTv = new Map<HTMLElement, () => void>();
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const items = JSON.parse(gallery.dataset.gallery!);
    const shots = items.filter((x: { kind: string }) => x.kind === 'image').length;
    const tiles = [...gallery.querySelectorAll<HTMLButtonElement>('[data-item]')];
    const still = (n: number) => {
      const item = items[n];
      if (!hoverTv.matches) return;
      tiles.forEach((t) => t.classList.toggle('is-on-tv', t === tiles[n] && item.kind === 'image'));
      const label = `SCREENSHOT ${items.slice(0, n + 1).filter((x: { kind: string }) => x.kind === 'image').length}/${shots}`;
      tv?.dispatchEvent(new CustomEvent('tv:image', { detail: item.kind === 'image' ? { src: item.thumb, label } : null }));
    };
    for (const tile of tiles) {
      const n = Number(tile.dataset.item);
      tile.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') still(n); });
      tile.addEventListener('focus', () => still(n));
      tile.addEventListener('click', () => {
        const from = (hoverTv.matches && screenRect()) || tile.getBoundingClientRect();
        document.dispatchEvent(new CustomEvent('lightbox:open', { detail: { title: gallery.dataset.title, items, index: n, from } }));
      });
    }
    const back = () => {
      tiles.forEach((t) => t.classList.remove('is-on-tv'));
      if (hoverTv.matches) tv?.dispatchEvent(new CustomEvent('tv:image', { detail: null }));
    };
    gallery.addEventListener('pointerleave', back);
    gallery.addEventListener('focusout', (e) => { if (!gallery.contains(e.relatedTarget as Node)) back(); });
    for (const tile of tiles) showOnTv.set(tile, () => still(Number(tile.dataset.item)));
  }
  // The viewer covered the page, so no pointerleave came: the TV shows what's under the cursor now.
  document.addEventListener('lightbox:close', () => {
    const hovered = [...showOnTv.keys()].find((t) => t.matches(':hover'));
    if (hovered) showOnTv.get(hovered)!();
    else {
      document.querySelectorAll('.is-on-tv').forEach((t) => t.classList.remove('is-on-tv'));
      if (hoverTv.matches) tv?.dispatchEvent(new CustomEvent('tv:image', { detail: null }));
    }
  });
</script>

<style>
  /* the list on the left, the TV on the right */
  .page { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr); gap: 56px; }
  .screen { margin-right: -56px; }
  .sticky { position: sticky; top: var(--bar-height); height: min(100vh - var(--bar-height), 640px); --tv-caption-right: 64px; --tv-caption-bottom: 26px; }

  h1 { margin: 48px 0 0; font-size: 44px; font-weight: 500; letter-spacing: -0.03em; }
  .intro { margin: 14px 0 40px; font-size: 17px; line-height: 1.55; color: var(--muted); }

  .project { position: relative; padding: 40px 0 64px; border-top: 1px solid var(--line); transition: opacity 0.15s; }
  /* the project on the TV: a bar at its side and a label; the others step back */
  .project::before {
    content: "";
    position: absolute;
    top: 40px;
    bottom: 64px;
    left: calc(-1 * min(28px, var(--gutter) - 6px));
    width: 2px;
    background: var(--accent);
    opacity: 0;
    transition: opacity 0.15s;
  }
  .project.is-on::before { opacity: 1; }
  .project:not(.is-on) { opacity: 0.5; }
  .project:not(.is-on):hover { opacity: 1; }
  .list { padding-bottom: 48px; }
  .meta { display: flex; align-items: center; gap: 10px; margin: 0 0 8px; font-size: 14px; color: var(--muted); }
  h2 { margin: 0; font-size: 32px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.15; }
  /* under NDA: the heading is a description, set quieter; a badge with a lock says why */
  .nda h2 { font-weight: 400; color: var(--muted); }
  .nda-note {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    margin: 12px 0 0;
    padding: 5px 12px 5px 10px;
    border: 1px solid var(--faint);
    border-radius: 8px;
    font-size: 14px;
    line-height: 1.3;
  }
  .nda-note svg { flex: none; width: 15px; height: 15px; fill: none; stroke: var(--accent); stroke-width: 1.8; stroke-linecap: round; }
  .nda-note b { font-weight: 500; color: var(--fg); }
  .nda-note span { color: var(--muted); }
  .nda-note span::before { content: "· "; }
  .sub { margin: 8px 0 0; font-size: 15px; color: var(--muted); }
  .summary { margin: 20px 0 0; font-size: 19px; line-height: 1.5; }
  .points { margin: 14px 0 0; padding-left: 18px; font-size: 16px; line-height: 1.55; color: var(--muted); }
  .points li + li { margin-top: 6px; }
  .points li::marker { color: var(--faint); }
  .stack { margin: 18px 0 0; font-size: 14px; color: var(--muted); }
  /* gallery: small screenshots in a row, the trailer first with a play mark; on wide screens
     the one under the cursor is on the TV and wears the accent */
  .gallery { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .tile { position: relative; flex: none; width: 72px; aspect-ratio: 4 / 3; padding: 0; overflow: hidden; border: 0; border-radius: 6px; background: #000; cursor: zoom-in; outline: 1px solid var(--line); }
  .tile img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .tile:hover, .tile:focus-visible, .tile.is-on-tv { outline: 2px solid var(--accent); outline-offset: 2px; }
  .trailer { cursor: pointer; }
  .play { position: absolute; left: 50%; top: 50%; translate: -50% -50%; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: rgb(0 0 0 / 0.6); color: #fff; }
  .play svg { width: 12px; height: 12px; margin-left: 2px; fill: currentColor; }
  .gallery-note { margin: 10px 0 0; font-size: 13px; color: var(--muted); }

  .links { display: flex; flex-wrap: wrap; gap: 8px 24px; margin: 14px 0 0; }
  .links a { color: var(--accent); text-decoration: none; }
  .links a:hover { text-decoration: underline; text-underline-offset: 0.18em; }

  /* narrower screens: a smaller TV above the list, scrolling away with the page */
  @media (max-width: 1024px) {
    .page { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .screen { order: -1; margin: 0 calc(-1 * var(--gutter)); }
    /* the TV has scrolled away: no project is marked as the one on it */
    .project::before, .intro .tunes, .gallery-note { display: none; }
    .project:not(.is-on) { opacity: 1; }
    .sticky { position: static; height: 40vh; --tv-caption-right: var(--gutter); --tv-caption-bottom: 8px; }
    h1 { margin-top: 32px; font-size: 36px; }
  }
  @media (max-width: 640px) {
    h2 { font-size: 26px; }
    .summary { font-size: 17px; }
    /* a strip to swipe through, tiles big enough to see */
    .gallery { flex-wrap: nowrap; overflow-x: auto; margin-right: calc(-1 * var(--gutter)); padding: 4px var(--gutter) 6px 4px; margin-left: -4px; scrollbar-width: none; }
    .tile { width: 132px; }
    /* the explanation goes on its own line, without the separator */
    .nda-note span { flex-basis: 100%; }
    .nda-note span::before { content: none; }
  }
</style>
