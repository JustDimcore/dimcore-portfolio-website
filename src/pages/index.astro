---
import Base from '../layouts/Base.astro';
import TvScene from '../components/TvScene.astro';
import QuickContacts from '../components/QuickContacts.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { channels } from '../data/channels';
import { links, coreSkills, skills, experience, education, languages, contacts } from '../data/profile';
---

<Base title="Dmytro Ilchenko — Software Engineer">
  <!-- slides in once the main menu is scrolled away (script below) -->
  <SiteHeader home />

  <main class="wrap" id="top">
    <section class="hero">
      <div class="intro">
        <h1 aria-label="Dmytro Ilchenko">
          <span aria-hidden="true"><span class="prompt">~$ </span>dmytro<span class="sep">_</span>ilchenko<span class="cursor"></span></span>
        </h1>
        <p class="role">
          Software Engineer
          <small>Gamedev &amp; Web</small>
        </p>
        <!-- top right, level with the name; under the role on narrow screens -->
        <div class="quick-wrap"><QuickContacts /></div>
        <nav aria-label="Main">
          {/* "Play something →" comes back once there are games to play here */}
          <a href="#about"><i>01</i>About me</a>
          <a href={links.projects}><i>02</i>Projects</a>
          <a href="#contact"><i>03</i>Contact</a>
        </nav>
      </div>

      <div class="stage">
        <TvScene channels={channels} />
      </div>
    </section>

    <section class="section" id="about" aria-labelledby="about-title">
      <h2 id="about-title" class="label">About</h2>
      <!-- the years are part of the story, not a row of big numbers -->
      <p class="lead">
        <span class="hi">Hi, I'm Dmytro and I build and create things.</span> I'm a software engineer specializing
        in game and web development with over 12 years of commercial <a href="#experience">experience</a>.
        Since 2014, I have worked on diverse <a href={links.projects}>projects</a> across
        various <a href="#skills">technologies</a>, focusing mostly on Unity/C# for games and Angular/TypeScript for web apps.
      </p>
    </section>

    <section class="section" id="skills" aria-labelledby="skills-title">
      <h2 id="skills-title" class="label">Skills</h2>
      <!-- one line per area; the core of the stack stands out -->
      <div class="sheet">
        {skills.map((group) => (
          <div>
            <h3>{group.title}</h3>
            <dl>
              {group.rows.map((row) => (
                <div>
                  <dt>{row.area}</dt>
                  <dd>
                    {row.items.map((item, i) => (
                      <>{coreSkills.has(item) ? <b>{item}</b> : item}{i < row.items.length - 1 && ', '}</>
                    ))}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </div>
    </section>

    <section class="section" id="experience" aria-labelledby="experience-title">
      <h2 id="experience-title" class="label">Experience</h2>
      <div class="tracks">
        {experience.map((track) => (
          <div>
            <h3 class="group">{track.track}</h3>
            <ol class="timeline">
              {track.jobs.map((job) => (
                <li>
                  <span class="years">{job.dates}</span>
                  <div>
                    <h4>{job.role} <span class="company">· {job.company}</span></h4>
                    {job.place && <p class="place">{job.place}</p>}
                    {job.project && <p class="project">{job.project}</p>}
                    <ul class="points">
                      {job.points.map((point) => <li>{point}</li>)}
                    </ul>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="background-title">
      <h2 id="background-title" class="label">Education</h2>
      <div class="background">
        <div>
          <h3 class="group">Education</h3>
          {education.map((e) => (
            <p class="entry"><b>{e.school}</b><span>{e.degree} · {e.years}</span></p>
          ))}
        </div>
        <div>
          <h3 class="group">Languages</h3>
          <dl class="languages">
            {languages.map((l) => (
              <div><dt>{l.name}</dt><dd>{l.level}</dd></div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <section class="section last-section" id="contact" aria-labelledby="contact-title">
      <h2 id="contact-title" class="label">Contact</h2>
      <dl class="contacts">
        {contacts.map((c) => (
          <div>
            <dt>{c.label}</dt>
            <dd>
              <a href={c.href} {...(c.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{c.text}</a>
              {c.href.startsWith('mailto:') && (
                <button type="button" class="copy" data-copy={c.text} aria-label={`Copy ${c.text}`}>copy</button>
              )}
            </dd>
          </div>
        ))}
      </dl>
    </section>
  </main>

  <SiteFooter />
</Base>

<script>
  // Show the sticky bar once the main menu under the name is scrolled out of view.
  const bar = document.querySelector<HTMLElement>('[data-bar]');
  const menu = document.querySelector('.intro nav');
  if (bar && menu) {
    new IntersectionObserver(([entry]) => {
      const show = !entry.isIntersecting;
      bar.classList.toggle('is-shown', show);
      bar.toggleAttribute('inert', !show);
    }).observe(menu);
  }

  // Copy the email to the clipboard; the button says so for a moment.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy!);
        button.textContent = 'copied';
      } catch {
        button.textContent = 'select it ↖';
      }
      setTimeout(() => (button.textContent = 'copy'), 1500);
    });
  }
</script>

<style>
  /* anchors land below the bar */
  .section { scroll-margin-top: 60px; }

  /* hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
    align-items: start;
    padding-top: 56px;
  }

  /* the name as a terminal prompt */
  h1 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(26px, 7vw, 34px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .prompt { font-weight: 400; color: var(--muted); }
  .sep { color: var(--muted); }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 0.95em;
    margin-left: 0.08em;
    vertical-align: -0.12em;
    background: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .cursor { animation: blink 1.1s steps(1) infinite; }
  }
  @keyframes blink { 50% { opacity: 0; } }

  .hero { position: relative; }
  .quick-wrap { position: absolute; top: 56px; right: 0; z-index: 2; }

  .role { margin: 22px 0 0; font-size: 19px; line-height: 1.4; }
  .role small { display: block; margin-top: 4px; font-size: 16px; color: var(--muted); }

  /* a numbered channel list, like the menu of an old TV */
  .intro nav { display: flex; flex-direction: column; max-width: 320px; margin-top: 36px; }
  .intro nav a {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    font-size: 17px;
    text-decoration: none;
    transition: color 0.2s;
  }
  /* the numbers are a quiet hint, the names carry the menu */
  .intro nav a i { font-style: normal; font-size: 0.75em; font-variant-numeric: tabular-nums; color: var(--faint); transition: color 0.2s; }
  .intro nav a:hover { color: var(--accent); }
  .intro nav a:hover i { color: var(--muted); }

  .stage {
    position: relative;
    height: 600px;
    margin-top: -36px;   /* the TV sits high, its antennas just under the contacts */
    margin-right: -56px;
    --tv-caption-right: 64px;
    --tv-caption-bottom: 26px;
  }

  /* sections below the hero: a label on the left, the content on the right */
  .section {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 48px;
    padding: 56px 0;
    border-top: 1px solid var(--line);
  }
  .hero + .section { margin-top: 24px; }
  .last-section { padding-bottom: 96px; }
  /* plain headings: the name is the only bit of code on the page */
  .label { margin: 0; font-size: 26px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.2; }
  .group { margin: 0 0 12px; font-size: 15px; font-weight: 400; color: var(--muted); }

  /* about */
  /* the greeting stands out, the rest of the text is quieter */
  #about { padding: 88px 0; }
  .lead {
    max-width: 760px;
    margin: 0;
    font-size: clamp(19px, 2vw, 23px);
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: var(--muted);
  }
  .lead .hi { color: var(--fg); }
  .lead a { color: var(--accent); text-underline-offset: 0.18em; text-decoration-thickness: 1px; }
  .lead a:hover { text-decoration-thickness: 2px; }

  /* skills: a spec sheet */
  .sheet { display: grid; gap: 28px; max-width: 900px; }
  .sheet h3 { margin: 0 0 6px; font-size: 15px; font-weight: 400; }
  .sheet dl { margin: 0; }
  .sheet dl div { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 24px; padding: 9px 0; border-top: 1px solid var(--line); }
  .sheet dt, .sheet dd { margin: 0; font-size: 15px; line-height: 1.55; color: var(--muted); }
  .sheet b { font-weight: 400; color: var(--fg); }

  /* experience */
  .tracks { display: grid; gap: 48px; max-width: 900px; }
  .tracks .group { margin-bottom: 20px; }
  .timeline { display: grid; gap: 32px; margin: 0; padding: 0; list-style: none; }
  .timeline > li { display: grid; grid-template-columns: 170px minmax(0, 1fr); gap: 24px; }
  .years { padding-top: 3px; font-size: 15px; font-variant-numeric: tabular-nums; color: var(--muted); }
  .timeline h4 { margin: 0; font-size: 20px; font-weight: 500; }
  .company { color: var(--muted); font-weight: 400; }
  .place { margin: 2px 0 0; font-size: 14px; color: var(--muted); }
  .project { margin: 10px 0 0; font-size: 15px; line-height: 1.5; color: var(--fg); }
  .points { margin: 10px 0 0; padding-left: 18px; font-size: 15px; line-height: 1.5; color: var(--muted); }
  .points li + li { margin-top: 4px; }
  .points li::marker { color: var(--faint); }

  /* education & languages */
  .background { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 32px 40px; max-width: 900px; }
  .entry { margin: 0; font-size: 17px; line-height: 1.45; }
  .entry b { display: block; font-weight: 500; }
  .entry span { color: var(--muted); font-size: 15px; }
  .languages { display: grid; gap: 8px; margin: 0; }
  .languages div { display: flex; justify-content: space-between; gap: 16px; padding-bottom: 8px; border-bottom: 1px solid var(--line); }
  .languages dt { font-size: 17px; }
  .languages dd { margin: 0; font-size: 15px; color: var(--muted); }

  /* contact */
  .contacts { display: grid; gap: 14px; margin: 0; }
  .contacts div { display: grid; grid-template-columns: 140px minmax(0, 1fr); align-items: baseline; gap: 24px; }
  .contacts dt { font-size: 15px; color: var(--muted); }
  .contacts dd { margin: 0; font-size: clamp(18px, 2.2vw, 27px); letter-spacing: -0.01em; overflow-wrap: anywhere; }
  .contacts a { text-decoration: none; border-bottom: 1px solid var(--faint); transition: color 0.2s, border-color 0.2s; }
  .contacts a:hover { color: var(--accent); border-color: var(--accent); }
  .contacts .copy {
    margin-left: 14px;
    padding: 3px 10px;
    border: 1px solid var(--faint);
    border-radius: 999px;
    background: none;
    font: inherit;
    font-size: 12px;
    color: var(--muted);
    vertical-align: middle;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .contacts .copy:hover { color: var(--accent); border-color: var(--accent); }


  @media (max-width: 1024px) {
    .hero { grid-template-columns: minmax(0, 1fr); padding-top: 40px; }
    .quick-wrap { position: static; margin-top: 20px; }
    .stage {
      height: clamp(320px, 62vw, 560px);
      margin: 8px calc(-1 * var(--gutter)) 0;
      --tv-caption-right: var(--gutter);
      --tv-caption-bottom: 12px;
    }
    .section, #about { grid-template-columns: minmax(0, 1fr); gap: 20px; padding: 40px 0; }
    .last-section { padding-bottom: 64px; }
  }
  @media (max-width: 640px) {
    .section { scroll-margin-top: 52px; }
  }
  @media (max-width: 480px) {
    .timeline > li, .contacts div, .sheet dl div { grid-template-columns: minmax(0, 1fr); gap: 4px; }
    .sheet dt { font-size: 13px; }
  }
</style>
