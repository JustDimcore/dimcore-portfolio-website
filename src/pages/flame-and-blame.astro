---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Base title="Flame & Blame Dev Contest" description="Flame & Blame: a first-person game that runs in the browser.">
  <SiteHeader />

  <main class="wrap page">
    <h1>Flame &amp; Blame Dev Contest</h1>
    <!-- the build is generated by Unity (public/games/flame-and-blame/): don't edit it, only size the frame -->
    <div class="frame">
      <iframe
        src="/games/flame-and-blame/index.html"
        allow="fullscreen; autoplay; pointer-lock"
        allowfullscreen
        scrolling="no"
        title="Flame & Blame Dev Contest"></iframe>
    </div>
    <a class="switch" href="/flame-and-blame-v2">
      <span class="tag">V2</span>
      <span class="label">Play the new version</span>
      <span aria-hidden="true">→</span>
    </a>
    <p class="note">Needs a computer with a mouse and a keyboard. Click the game to capture the cursor.</p>
  </main>

  <SiteFooter />
</Base>

<style>
  .page { padding-block: 40px; }
  h1 { margin: 0 0 24px; }
  /* under the player: the new version is the main thing to click here */
  .switch { display: flex; align-items: center; gap: 14px; width: 100%; max-width: 960px; box-sizing: border-box; margin: 20px 0 0; padding: 18px 24px; border-radius: 10px; background: var(--accent); color: var(--bg); font-size: 20px; font-weight: 700; text-decoration: none; }
  .switch .label { flex: 1; }
  .switch .tag { padding: 3px 10px; border-radius: 6px; background: var(--bg); color: var(--accent); font-family: var(--font-mono, monospace); font-size: 16px; font-weight: 800; letter-spacing: 0.04em; }
  .switch:hover { filter: brightness(1.1); }
  /* the build's page is a 960×600 canvas (16:10) plus a 38px footer; on a narrower window the frame scrolls sideways */
  .frame { max-width: 960px; overflow-x: auto; }
  iframe { display: block; width: 960px; height: 638px; border: 0; background: #000; }
  .note { margin: 16px 0 0; font-size: 14px; color: var(--muted); }
  @media (pointer: coarse) {
    .frame { display: none; }
    .note { font-size: 16px; color: var(--fg); }
  }
</style>
