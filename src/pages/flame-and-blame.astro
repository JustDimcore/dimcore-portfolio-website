---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Base title="Flame & Blame Dev Contest" description="Flame & Blame: a first-person game that runs in the browser.">
  <SiteHeader />

  <main class="wrap page">
    <h1>Flame &amp; Blame Dev Contest</h1>
    <a class="switch" href="/flame-and-blame-v2">Play the new version <span aria-hidden="true">→</span></a>
    <!-- the build is generated by Unity (public/games/flame-and-blame/): don't edit it, only size the frame -->
    <div class="frame">
      <iframe
        src="/games/flame-and-blame/index.html"
        allow="fullscreen; autoplay; pointer-lock"
        allowfullscreen
        scrolling="no"
        title="Flame & Blame Dev Contest"></iframe>
    </div>
    <p class="note">Needs a computer with a mouse and a keyboard. Click the game to capture the cursor.</p>
  </main>

  <SiteFooter />
</Base>

<style>
  .page { padding-block: 40px; }
  h1 { margin: 0 0 16px; }
  .switch { display: inline-block; margin: 0 0 24px; padding: 12px 20px; border-radius: 8px; background: var(--accent); color: var(--bg); font-weight: 700; text-decoration: none; }
  .switch:hover { filter: brightness(1.1); }
  /* the build's page is a 960×600 canvas (16:10) plus a 38px footer; on a narrower window the frame scrolls sideways */
  .frame { max-width: 960px; overflow-x: auto; }
  iframe { display: block; width: 960px; height: 638px; border: 0; background: #000; }
  .note { margin: 16px 0 0; font-size: 14px; color: var(--muted); }
  @media (pointer: coarse) {
    .frame { display: none; }
    .note { font-size: 16px; color: var(--fg); }
  }
</style>
