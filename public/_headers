# Unity WebGL build (Brotli). The files are already compressed: the server only labels them.
/games/flame-and-blame/Build/*
  Cache-Control: no-cache

/games/flame-and-blame/Build/*.wasm.br
  Content-Type: application/wasm
  Content-Encoding: br

/games/flame-and-blame/Build/*.js.br
  Content-Type: application/javascript
  Content-Encoding: br

/games/flame-and-blame/Build/*.data.br
  Content-Type: application/octet-stream
  Content-Encoding: br
